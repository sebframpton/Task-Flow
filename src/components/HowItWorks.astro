---
const steps = [
    {
        number: "01",
        title: "Create Account",
        description:
            "Sign up for a free account in less than 2 minutes and start exploring the platform.",
    },
    {
        number: "02",
        title: "Connect Tools",
        description:
            "Integrate with your favorite apps like Slack, GitHub, and Jira with just a few clicks.",
    },
    {
        number: "03",
        title: "Boost Productivity",
        description:
            "Automate tasks, analyze data, and watch your team efficiency skyrocket immediately.",
    },
];
---

<section
    id="how-it-works"
    class="py-24 bg-white/[0.01] border-y border-white/5"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
                How It <span class="text-gradient">Works</span>
            </h2>
            <p class="text-lg text-muted-slate">
                Simple, fast, and intuitive. Get from zero to productive in
                three easy steps.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
            <!-- Connection line (Desktop only) -->
            <div
                class="hidden md:block absolute top-[60px] left-[20%] right-[20%] h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent"
            >
            </div>

            {
                steps.map((step) => (
                    <div class="relative text-center group">
                        <div class="w-20 h-20 bg-accent-gradient rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_30px_rgba(99,102,241,0.3)] relative z-10 transition-transform group-hover:scale-110">
                            <span class="text-2xl font-bold">
                                {step.number}
                            </span>
                        </div>
                        <h3 class="text-2xl font-bold mb-4">{step.title}</h3>
                        <p class="text-muted-slate leading-relaxed">
                            {step.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
