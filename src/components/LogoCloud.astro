---
const logos = ["Acme Corp", "GlobalSync", "Vertex", "Nova", "Pulse", "Enigma"];
---

<section class="py-20 border-y border-white/5 bg-white/[0.02]">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <p
            class="text-sm font-medium text-muted-slate mb-10 uppercase tracking-widest"
        >
            Trusted by forward-thinking teams worldwide
        </p>

        <div
            class="flex flex-wrap items-center justify-center gap-12 md:gap-20 opacity-40 grayscale hover:grayscale-0 transition-all duration-500"
        >
            {
                logos.map((logo) => (
                    <span class="text-2xl font-bold tracking-tighter whitespace-nowrap">
                        {logo}
                    </span>
                ))
            }
        </div>
    </div>
</section>
