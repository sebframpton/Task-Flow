---
import { ArrowRight } from "lucide-react";
---

<section class="py-24 px-6 relative overflow-hidden">
    <div
        class="absolute -bottom-20 -left-20 w-[600px] h-[600px] bg-accent/10 blur-[120px] rounded-full -z-10"
    >
    </div>
    <div
        class="absolute top-0 right-0 w-[400px] h-[400px] bg-purple-500/5 blur-[100px] rounded-full -z-10"
    >
    </div>

    <div
        class="max-w-5xl mx-auto glass-card p-12 md:p-20 text-center relative overflow-hidden"
    >
        <!-- Inner Glow -->
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[1px] bg-gradient-to-r from-transparent via-accent/50 to-transparent"
        >
        </div>

        <h2 class="text-4xl md:text-6xl font-bold mb-8 leading-tight">
            Ready to Supercharge <br />
            <span class="text-gradient">Your Team?</span>
        </h2>
        <p class="text-xl text-muted-slate mb-12 max-w-2xl mx-auto">
            Join over 10,000+ teams using TaskFlow to streamline their projects
            and boost productivity.
        </p>

        <!-- Formspree Integration -->
        <form
            action="https://formspree.io/f/mjvnrqkb"
            method="POST"
            class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto"
        >
            <input
                type="email"
                name="email"
                placeholder="Enter your email"
                required
                class="w-full px-6 py-4 rounded-lg bg-white/5 border border-white/10 focus:border-accent focus:outline-none transition-colors"
            />
            <button
                type="submit"
                class="btn-primary w-full sm:w-auto flex items-center justify-center gap-2 whitespace-nowrap"
            >
                Get Started
                <ArrowRight className="w-4 h-4" />
            </button>
        </form>

        <p class="mt-6 text-sm text-muted-slate">
            No credit card required • 14-day free trial • Cancel anytime
        </p>
    </div>
</section>
