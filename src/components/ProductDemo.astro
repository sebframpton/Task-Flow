    <!-- Pulse Effect in background -->
    <div
        class="absolute -bottom-1/2 -right-1/4 w-[150%] aspect-square bg-accent/5 blur-[120px] rounded-full -z-10 group-hover:bg-accent/10 transition-colors duration-1000"
    >
    </div>
</div>

<style>
    .product-demo-container {
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.05),
            0 20px 50px -10px rgba(0, 0, 0, 0.5);
    }

    /* Animations */
    @keyframes taskIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes listIn {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes checkmarkDraw {
        from {
            stroke-dashoffset: 20;
            opacity: 0;
        }
        to {
            stroke-dashoffset: 0;
            opacity: 1;
        }
    }

    @keyframes progressFill {
        from {
            stroke-dashoffset: 188.4;
        }
        to {
            stroke-dashoffset: 47.1;
        } /* 75% of 188.4 */
    }

    @keyframes popIn {
        0% {
            opacity: 0;
            transform: scale(0.8) translateY(-10px);
        }
        70% {
            transform: scale(1.05);
        }
        100% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .animate-task-in {
        animation: taskIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.5s;
    }

    .animate-list-2 {
        animation: listIn 0.5s ease-out forwards 1.2s;
    }

    .checkmark {
        stroke-dasharray: 20;
        animation: checkmarkDraw 0.4s ease-out forwards 1.7s;
    }

    .progress-path {
        animation: progressFill 1.5s cubic-bezier(0.65, 0, 0.35, 1) forwards
            0.8s;
    }

    .animate-notif {
        animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards
            2.5s;
    }

    /* Counter animation simulation (simple CSS version) */
    .counter {
        animation: pulseText 2s ease-in-out infinite alternate;
    }

    @keyframes pulseText {
        from {
            fill-opacity: 0.8;
        }
        to {
            fill-opacity: 1;
        }
    }

    .perspective-1000 {
        perspective: 1000px;
    }

    .transform-style-3d {
        transform-style: preserve-3d;
    }

    .rotate-x-1 {
        transform: rotateX(1deg);
    }

    .rotate-y-1 {
        transform: rotateY(-1deg);
    }

    /* Tooltip Animation */
    @keyframes tooltipFade {
        0%,
        10% {
            opacity: 0;
            transform: translateY(10px);
        }
        20%,
        80% {
            opacity: 1;
            transform: translateY(0);
        }
        90%,
        100% {
            opacity: 0;
            transform: translateY(-10px);
        }
    }

    .animate-tooltips {
        animation: tooltipFade 6s ease-in-out infinite;
    }

    .sidebar-items text {
        pointer-events: none;
    }

    .hover-group:hover rect {
        fill-opacity: 0.08 !important;
    }

    .hover-group:hover text {
        fill-opacity: 1 !important;
    }
</style>
