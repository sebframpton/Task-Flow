---
const testimonials = [
    {
        name: "Sarah Johnson",
        role: "Product Manager at TechFlow",
        content:
            "TaskFlow has completely transformed how our team collaborates. The analytics features are a game-changer.",
        avatar: "SJ",
    },
    {
        name: "Michael Chen",
        role: "CTO at GlobalSync",
        content:
            "The best project management tool I've used. Periodic updates and enterprise security give us peace of mind.",
        avatar: "MC",
    },
    {
        name: "Emma Williams",
        role: "Creative Director at Nova",
        content:
            "Stunning interface and lightning-fast performance. It makes managing complex workflows actually enjoyable.",
        avatar: "EW",
    },
];
---

<section id="testimonials" class="py-24 relative overflow-hidden">
    <div
        class="absolute top-1/2 left-0 w-[500px] h-[500px] bg-accent/5 blur-[120px] rounded-full -z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
                Loved by <span class="text-gradient">Thousands</span>
            </h2>
            <p class="text-lg text-muted-slate">
                Don't just take our word for it. Here's what industry leaders
                are saying about us.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                testimonials.map((t) => (
                    <div class="glass-card p-10 flex flex-col justify-between hover:border-accent/30 transition-colors duration-500">
                        <div>
                            <div class="flex gap-1 mb-6">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <svg
                                        class="w-5 h-5 text-yellow-500 fill-current"
                                        viewBox="0 0 20 20"
                                    >
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>
                            <p class="text-lg italic text-white/90 leading-relaxed mb-8">
                                "{t.content}"
                            </p>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-accent-gradient flex items-center justify-center font-bold text-lg">
                                {t.avatar}
                            </div>
                            <div>
                                <h4 class="font-bold">{t.name}</h4>
                                <p class="text-sm text-muted-slate">{t.role}</p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
