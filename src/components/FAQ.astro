---
import { ChevronDown } from "lucide-react";

const faqs = [
    {
        question: "How does the 14-day free trial work?",
        answer: "You can sign up for TaskFlow for free, with no credit card required. You will have full access to all Pro features for 14 days. After the trial ends, you can choose a plan or continue with our free tier.",
    },
    {
        question: "Can I change my plan later?",
        answer: "Yes, you can upgrade or downgrade your plan at any time from your account settings. If you upgrade, the change will be immediate. If you downgrade, it will take effect at the end of your current billing cycle.",
    },
    {
        question: "Is my data secure with TaskFlow?",
        answer: "Absolutely. We use enterprise-grade encryption (AES-256) for all data at rest and TLS 1.3 for data in transit. We also perform regular security audits and are SOC2 Type II compliant.",
    },
    {
        question: "Do you offer discounts for non-profits?",
        answer: "Yes! We love supporting organizations that make a difference. Contact our support team with proof of your non-profit status, and we will apply a 50% discount to your account.",
    },
    {
        question: "What happens if I exceed my storage limit?",
        answer: "We will notify you when you reach 80% and 90% of your storage limit. If you exceed it, you will still be able to access your data, but you won't be able to upload new files until you upgrade or free up space.",
    },
];
---

<section id="faq" class="py-24 bg-white/[0.01]">
    <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
                Frequently Asked <span class="text-gradient">Questions</span>
            </h2>
            <p class="text-lg text-muted-slate">
                Everything you need to know about TaskFlow and our services.
            </p>
        </div>

        <div class="space-y-4">
            {
                faqs.map((faq, index) => (
                    <div class="glass-card overflow-hidden">
                        <button
                            class="w-full px-8 py-6 text-left flex items-center justify-between hover:bg-white/[0.02] transition-colors faq-toggle"
                            data-index={index}
                        >
                            <span class="text-lg font-semibold">
                                {faq.question}
                            </span>
                            <ChevronDown className="w-5 h-5 text-muted-slate transition-transform duration-300" />
                        </button>
                        <div class="px-8 pb-0 max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-content">
                            <p class="py-6 text-muted-slate leading-relaxed border-t border-white/5">
                                {faq.answer}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    const toggles = document.querySelectorAll(".faq-toggle");

    toggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
            const content = toggle.nextElementSibling as HTMLElement;
            const icon = toggle.querySelector("svg");

            document
                .querySelectorAll(".faq-content")
                .forEach((otherContent) => {
                    const htmlContent = otherContent as HTMLElement;
                    if (htmlContent !== content) {
                        htmlContent.style.maxHeight = "0";
                        const otherIcon =
                            htmlContent.previousElementSibling?.querySelector(
                                "svg",
                            );
                        if (otherIcon) {
                            (
                                otherIcon as unknown as HTMLElement
                            ).style.transform = "rotate(0deg)";
                        }
                    }
                });

            if (
                content.style.maxHeight === "0px" ||
                content.style.maxHeight === ""
            ) {
                content.style.maxHeight = content.scrollHeight + "px";
                if (icon) icon.style.transform = "rotate(180deg)";
            } else {
                content.style.maxHeight = "0";
                if (icon) icon.style.transform = "rotate(0deg)";
            }
        });
    });
</script>
